APP_MODE=tiktok
HOST=127.0.0.1
PORT=5173
CHAT_PROVIDER=yoroll
YOROLL_CHAT_BASE_URL=https://chat-api.lineargame.ai/api/v1
YOROLL_API_BASE_URL=https://api.lineargame.ai/api/v1
YOROLL_CONTENT_LANGUAGE=en-US
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
VITE_TIKTOK_CLIENT_KEY=
# Public endpoints embedded into the static package. No mini API adapter required.
VITE_YOROLL_API_BASE_URL=https://api.lineargame.ai/api/v1
VITE_YOROLL_CHAT_BASE_URL=https://chat-api.lineargame.ai/api/v1
VITE_YOROLL_CONTENT_LANGUAGE=en-US
# HTTPS public mapping of node ID -> { album_id, episode_id, vid }. No secrets/tokens.
VITE_TIKTOK_MEDIA_MAP_URL=
TIKTOK_MEDIA_MAP_FILE=
# Exact frontend origin from the TikTok test/deploy environment; no wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only on the HTTPS adapter for cross-site packaged clients.
COOKIE_CROSS_SITE=false
