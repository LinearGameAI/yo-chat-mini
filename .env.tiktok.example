APP_MODE=tiktok
HOST=127.0.0.1
PORT=5173
CHAT_PROVIDER=mock
CONTENT_SOURCE=live
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
VITE_TIKTOK_CLIENT_KEY=
# HTTPS adapter service origin in a packaged TikTok build:
VITE_API_BASE_URL=
TIKTOK_MEDIA_MAP_FILE=
# Exact frontend origin from the TikTok test/deploy environment; no wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only on the HTTPS adapter for cross-site packaged clients.
COOKIE_CROSS_SITE=false
