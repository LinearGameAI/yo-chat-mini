# Copy to .env.local. No credentials needed for local mode.
APP_MODE=local
PORT=5173
HOST=127.0.0.1
CHAT_PROVIDER=mock
CONTENT_SOURCE=live
# Optional server-only OpenAI-compatible provider. Never prefix secrets with VITE_.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# Real TikTok identity: only used when APP_MODE=tiktok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Frontend needs only the public client key.
VITE_TIKTOK_CLIENT_KEY=
VITE_API_BASE_URL=
# Server-only JSON mapping: node ID -> { album_id, episode_id, vid, play_auth_token? }
# Tokens are temporary; use a credential issuer before production deployment.
TIKTOK_MEDIA_MAP_FILE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_CROSS_SITE=false
