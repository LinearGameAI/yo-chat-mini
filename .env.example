# Copy to .env.local. Local viewing needs no credentials; Yoroll chat requires user auth.
APP_MODE=local
PORT=5173
HOST=127.0.0.1
CHAT_PROVIDER=yoroll
YOROLL_CHAT_BASE_URL=https://chat-api.lineargame.ai/api/v1
# YorollApp main API: detail -> game.json -> chapters. Online only; no snapshot fallback.
YOROLL_API_BASE_URL=https://api.lineargame.ai/api/v1
YOROLL_CONTENT_LANGUAGE=en-US
# Vercel: use a dedicated Neon Postgres database. Local runs default to SQLite.
DATABASE_URL=
# Optional OpenAI-compatible provider; CHAT_MODEL also selects a Yoroll model when set.
# Never prefix secrets with VITE_.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# Real TikTok identity: only used when APP_MODE=tiktok.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Frontend needs only the public client key.
VITE_TIKTOK_CLIENT_KEY=
VITE_YOROLL_API_BASE_URL=https://api.lineargame.ai/api/v1
VITE_YOROLL_CHAT_BASE_URL=https://chat-api.lineargame.ai/api/v1
VITE_YOROLL_CONTENT_LANGUAGE=en-US
VITE_TIKTOK_MEDIA_MAP_URL=
# Optional DSN override; omit this variable to use the built-in project DSN.
# Explicitly set it to an empty string to disable Sentry.
# VITE_SENTRY_DSN=
# Optional overrides; build environment and Vercel commit are used by default.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# Server-only JSON mapping: node ID -> { album_id, episode_id, vid, play_auth_token? }
# Tokens are temporary; use a credential issuer before production deployment.
TIKTOK_MEDIA_MAP_FILE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_CROSS_SITE=false
