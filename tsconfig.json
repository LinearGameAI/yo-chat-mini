{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "types": ["vite/client", "node"], "noEmit": true
  },
  "include": ["api", "src", "shared", "server", "scripts", "tests", "vite.config.ts", "playwright.config.ts"]
}
